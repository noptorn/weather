@charset "utf-8";

:root { color-scheme: light; --ink: #17253a; --muted: #627188; --blue: #155=
eef; --bg: #f3f7fb; --line: #dce5f0; --card: #fff; --navy: #102347; --teal:=
 #15b8a6; }

* { box-sizing: border-box; }

html { min-width: 320px; }

body { margin: 0px; background: var(--bg); color: var(--ink); font: 16px / =
1.75 Tahoma, "Noto Sans Thai", sans-serif; }

.top, footer { display: flex; align-items: center; justify-content: space-b=
etween; gap: 18px; padding: 16px max(24px, -540px + 50vw); background: rgb(=
255, 255, 255); border-bottom: 1px solid var(--line); }

.brand { display: flex; align-items: center; gap: 12px; color: var(--navy);=
 font-weight: 700; text-decoration: none; }

.brand img { border-radius: 12px; }

.badge { padding: 4px 11px; border: 1px solid var(--line); border-radius: 9=
99px; color: var(--muted); font-size: 13px; }

.back, footer a { color: var(--blue); text-decoration: none; }

.back:hover, footer a:hover, .arrow:hover { text-decoration: underline; }

main { width: min(1080px, 100% - 40px); margin: 0px auto; }

.hero { padding: 82px 0px 48px; max-width: 820px; }

.eyebrow { color: var(--blue); font-size: 12px; font-weight: 700; letter-sp=
acing: 0.14em; }

.hero h1, .legal h1 { margin: 8px 0px 14px; color: var(--navy); font-size: =
clamp(32px, 5vw, 52px); line-height: 1.2; }

.lead { max-width: 760px; color: rgb(67, 83, 106); font-size: 18px; }

.notice { margin-top: 26px; padding: 16px 20px; border-left: 4px solid var(=
--teal); border-radius: 8px; background: rgb(230, 248, 245); }

.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.cards article, .how { padding: 24px; border: 1px solid var(--line); border=
-radius: 14px; background: var(--card); }

.number { color: var(--teal); font-size: 13px; font-weight: 700; }

.cards h2, .how h2, .legal h2 { color: var(--navy); font-size: 21px; }

.cards p, .how p { color: var(--muted); }

.arrow { display: inline-flex; gap: 8px; color: var(--blue); font-weight: 7=
00; text-decoration: none; }

.how { margin: 18px 0px 56px; }

.legal { max-width: 800px; padding: 44px 0px 70px; }

.legal h1 { font-size: clamp(32px, 5vw, 44px); }

.legal h2 { margin: 30px 0px 5px; }

.legal p { margin: 10px 0px; color: rgb(52, 68, 92); }

.legal .updated { color: var(--muted); font-size: 14px; }

.legal hr { margin: 30px 0px; border-right: 0px; border-bottom: 0px; border=
-left: 0px; border-image: none; border-top: 1px solid var(--line); }

footer { border-top: 1px solid var(--line); border-bottom: 0px; color: var(=
--muted); font-size: 14px; }

footer nav { display: flex; gap: 18px; }

@media (max-width: 720px) {
  .cards { grid-template-columns: 1fr; }
  .hero { padding: 50px 0px 32px; }
  .top, footer { padding: 12px 20px; flex-wrap: wrap; }
  footer { align-items: flex-start; }
}
